<view class="page">
  <view class="filters">
    <view wx:for="{{filters}}" wx:key="v" class="filter {{filter===item.v?'active':''}}" data-value="{{item.v}}" bindtap="setFilter">{{item.n}}</view>
  </view>
  <view wx:if="{{guest}}" class="empty">登录后即可查看作品 <text class="login-link" bindtap="goLogin">去登录</text></view>
  <view wx:elif="{{!tasks.length&&!loading}}" class="empty">还没有创作记录</view>
  <view class="grid">
    <view wx:for="{{tasks}}" wx:key="id" class="work-card" data-id="{{item.id}}" bindtap="openTask">
      <view class="media">
        <image wx:if="{{item.assets.length && item.feature_type==='image'}}" src="{{item.assets[0].url}}" mode="aspectFill"/>
        <view wx:elif="{{item.assets.length && item.feature_type==='video'}}" class="video-cover">▶</view>
        <view wx:else class="pending">{{item.pendingText}}</view>
      </view>
      <view class="body">
        <view class="prompt">{{item.prompt}}</view>
        <view class="meta">
          <text>{{item.points}} 积分</text>
          <text class="state {{item.status}}">{{item.statusText}}</text>
        </view>
        <button wx:if="{{item.assets.length}}" class="delete" data-id="{{item.assets[0].id}}" catchtap="remove">删除作品</button>
      </view>
    </view>
  </view>
</view>
