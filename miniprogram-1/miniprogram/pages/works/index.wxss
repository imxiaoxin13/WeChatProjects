.filters{display:flex;gap:12rpx;margin-bottom:28rpx}.filter{padding:14rpx 28rpx;border-radius:99rpx;background:#e9ecf3;color:#717a8c;font-size:25rpx}.filter.active{color:#fff;background:#6259e8}.login-link{color:#6259e8;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.work-card{background:#fff;border-radius:24rpx;overflow:hidden}.media{height:310rpx;background:#e9ecf3}.media image{width:100%;height:100%}.pending,.video-cover{height:100%;display:flex;align-items:center;justify-content:center;color:#858da0;font-size:25rpx}.video-cover{font-size:60rpx;color:#fff;background:linear-gradient(135deg,#273047,#607194)}.body{padding:20rpx}.prompt{font-size:25rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;justify-content:space-between;margin-top:13rpx;color:#99a0af;font-size:21rpx}.state.succeeded{color:#17a36a}.state.failed,.state.rejected{color:#e35151}.state.pending_review{color:#d48b16}.delete{margin-top:12rpx;padding:0;background:none;border:0;color:#e35151;font-size:22rpx;text-align:left}.delete::after{border:0}

