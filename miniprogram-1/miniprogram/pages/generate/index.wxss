.page{padding:24rpx 28rpx 220rpx}
.hero{padding:36rpx 32rpx 28rpx;border-radius:32rpx;color:#fff;margin-bottom:24rpx;background:linear-gradient(140deg,#171a35 0%,#4b45ba 62%,#6e8fff 100%);box-shadow:0 20rpx 44rpx rgba(62,62,150,.18)}
.hero.success{background:linear-gradient(140deg,#123a28,#16a36a)}
.hero.fail{background:linear-gradient(140deg,#3a1218,#e35151)}
.hero-top{display:flex;align-items:center;gap:24rpx}
.boot{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;color:#8b93a5;font-size:26rpx}
.spinner{width:72rpx;height:72rpx;flex-shrink:0;border-radius:50%;border:7rpx solid rgba(255,255,255,.22);border-top-color:#fff;animation:spin .9s linear infinite}
.spinner.accent{border-color:rgba(99,91,255,.16);border-top-color:#635bff}
@keyframes spin{to{transform:rotate(360deg)}}
.mark{width:72rpx;height:72rpx;flex-shrink:0;border-radius:24rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.18);font-size:28rpx;font-weight:800}
.hero-copy{flex:1;min-width:0}
.hero-title{font-size:40rpx;font-weight:800;line-height:1.25}
.hero-sub{margin-top:8rpx;font-size:24rpx;line-height:1.5;opacity:.78}
.card-title{font-size:28rpx;font-weight:700;line-height:1.4;color:#182033}
.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}
.steps-card .card-title{margin-bottom:24rpx}
.steps{display:flex;justify-content:space-between}
.step{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:20rpx;color:#9aa2b2;line-height:1.3;text-align:center}
.rail{width:100%;height:40rpx;display:flex;align-items:center}
.rail-seg{flex:1;height:2rpx;background:#e6e8ef}
.step:first-child .rail-seg.left,.step:last-child .rail-seg.right{background:transparent}
.dot{width:40rpx;height:40rpx;flex-shrink:0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700;background:#eef0f5;color:#8b93a5;position:relative;z-index:1}
.step.active{color:#635bff}
.step.active .dot{background:#635bff;color:#fff}
.step.active .rail-seg.left{background:#16a36a}
.step.done{color:#16a36a}
.step.done .dot{background:#16a36a;color:#fff}
.step.done .rail-seg{background:#16a36a}
.step.fail{color:#e35151}
.step.fail .dot{background:#e35151;color:#fff}
.step.fail .rail-seg.left{background:#e35151}
.stage{display:flex;justify-content:center;background:#f4f6fb;border-radius:22rpx;overflow:hidden}
.stage-box{position:relative;max-width:100%}
.stage-box image,.stage-box video,.stage-empty{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}
.stage-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;color:#8b93a5;font-size:24rpx;padding:24rpx;text-align:center;line-height:1.5}
.pulse{width:72rpx;height:72rpx;border-radius:20rpx;background:linear-gradient(135deg,#d9dcff,#cfd8ff);animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{50%{opacity:.45;transform:scale(.92)}}
.prompt{margin-top:16rpx;font-size:28rpx;line-height:1.7;color:#4a5368;word-break:break-all}
.info-card{padding-top:8rpx;padding-bottom:8rpx}
.info{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #eef0f5}
.info:last-child{border-bottom:0}
.info-k{font-size:26rpx;color:#8b93a5;line-height:1.4}
.info-v{font-size:26rpx;font-weight:600;color:#182033;line-height:1.4}
.hint{margin:8rpx 8rpx 0;text-align:center;color:#8b93a5;font-size:24rpx;line-height:1.6}
.actions{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;display:flex;align-items:center;gap:20rpx;box-shadow:0 -10rpx 30rpx rgba(20,30,60,.06)}
.act-btn{flex:1;height:88rpx;border-radius:44rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:700;line-height:1}
.act-btn.ghost{background:#f4f6fa;color:#3d4660}
.act-btn.main{color:#fff;background:linear-gradient(135deg,#6d5dfc,#387cff)}
