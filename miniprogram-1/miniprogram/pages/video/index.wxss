.page{padding-bottom:200rpx}.intro{padding:20rpx 8rpx 30rpx}.title{font-size:46rpx;font-weight:800;margin:18rpx 0 10rpx}.modes{display:flex;padding:8rpx;background:#e9ecf3;border-radius:18rpx;margin-bottom:24rpx}.mode{flex:1;text-align:center;padding:20rpx 8rpx;border-radius:14rpx;color:#7d8595;font-size:25rpx;white-space:nowrap}.mode.active{background:#fff;color:#252d3e;font-weight:700;box-shadow:0 5rpx 15rpx rgba(0,0,0,.05)}.label{font-size:28rpx;font-weight:700}.prompt{width:100%;height:240rpx;margin-top:20rpx;line-height:1.7}.image-tip{font-size:22rpx;color:#9aa2b2;margin-top:8rpx}.image-scroll{white-space:nowrap;margin-top:20rpx;height:190rpx}.image-item,.add{display:inline-flex;width:170rpx;height:170rpx;border-radius:20rpx;margin-right:15rpx;vertical-align:top;position:relative}.image-item image{width:100%;height:100%;border-radius:20rpx}.remove{position:absolute;right:-6rpx;top:-6rpx;width:38rpx;height:38rpx;line-height:34rpx;text-align:center;border-radius:50%;background:rgba(18,24,38,.78);color:#fff;font-size:28rpx}.add{background:#f4f6fa;border:2rpx dashed #d5dae6;align-items:center;justify-content:center;flex-direction:column;color:#808899;font-size:38rpx;box-sizing:border-box}.add text{font-size:22rpx}.options-card{padding-bottom:20rpx}.options-title{padding-bottom:22rpx}.parameter{padding:22rpx 0;border-top:1rpx solid #eef0f5}.parameter.last{padding-bottom:4rpx}.parameter-title{font-size:24rpx;color:#70798b;margin-bottom:16rpx}.duration-control{height:94rpx;padding:10rpx 12rpx 10rpx 4rpx;border-radius:22rpx;background:#f7f7f9;display:flex;align-items:center}.duration-slider{flex:1;margin:0 18rpx 0 0}.duration-value{width:130rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(20,26,40,.1);font-size:30rpx;font-weight:800;color:#111}.duration-value text{font-size:22rpx;margin-left:5rpx;color:#697184}.choices{white-space:nowrap}.choice{display:inline-block;padding:13rpx 24rpx;background:#f1f3f8;border:2rpx solid transparent;border-radius:14rpx;font-size:23rpx;color:#657086;margin-right:12rpx;box-sizing:border-box}.choice.active{color:#4e63e8;background:#eef1ff;border-color:#8794ff;font-weight:700}.fab-wrap{position:fixed;left:0;right:0;bottom:calc(40rpx + env(safe-area-inset-bottom));z-index:100;pointer-events:none;display:flex;justify-content:center}.fab{pointer-events:auto;width:420rpx;height:96rpx;margin:0;padding:0;line-height:96rpx;border:0;border-radius:999rpx;color:#fff;font-size:32rpx;font-weight:700;background:linear-gradient(135deg,#3d4dff,#2f6bff);box-shadow:0 18rpx 42rpx rgba(47,91,255,.38)}.fab::after{border:0}
