.page {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.intro {
  padding: 20rpx 8rpx 32rpx;
}

.intro-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #182033;
}

.intro-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8b93a5;
}

.form-card {
  padding: 28rpx;
}

.tabs {
  display: flex;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #f4f6fa;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1;
  color: #717a8c;
}

.tab.active {
  background: #fff;
  color: #182033;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(25, 35, 70, .06);
}

.field {
  width: 100%;
  height: 96rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f7f8fb;
  font-size: 28rpx;
  line-height: 96rpx;
  box-sizing: border-box;
}

.submit,
.wechat {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.submit {
  color: #fff;
  background: linear-gradient(135deg, #6d5dfc, #387cff);
}

.wechat {
  margin-top: 0;
  color: #fff;
  background: #07c160;
}

.pressed {
  opacity: .88;
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 40rpx 12rpx 24rpx;
  color: #9aa2b2;
  font-size: 22rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e6e9f0;
}
