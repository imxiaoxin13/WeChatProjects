<view class="page">
  <view class="intro">
    <view class="intro-title">{{mode==='register' ? '注册账号' : '账号登录'}}</view>
    <view class="intro-sub">{{mode==='register' ? '注册后可使用账号密码登录，并随时绑定微信' : '使用已注册的账号和密码登录'}}</view>
  </view>

  <view class="card form-card">
    <view class="tabs">
      <view class="tab {{mode==='login' ? 'active' : ''}}" data-mode="login" bindtap="setMode">登录</view>
      <view class="tab {{mode==='register' ? 'active' : ''}}" data-mode="register" bindtap="setMode">注册</view>
    </view>

    <input class="field" placeholder="账号（字母、数字或下划线）" value="{{username}}" bindinput="onUsername" maxlength="32"/>
    <input class="field" password placeholder="密码（至少 6 位）" value="{{password}}" bindinput="onPassword" maxlength="64"/>
    <input wx:if="{{mode==='register'}}" class="field" placeholder="昵称（选填）" value="{{nickname}}" bindinput="onNickname" maxlength="20"/>

    <view class="submit" hover-class="pressed" bindtap="submit">{{mode==='register' ? '注册并登录' : '登录'}}</view>
  </view>

  <view class="divider"><view class="divider-line"></view><text>或</text><view class="divider-line"></view></view>
  <view class="wechat" hover-class="pressed" bindtap="wechatLogin">微信一键登录</view>
</view>
