.hero {
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(140deg, #171a35 0%, #4b45ba 62%, #6e8fff 100%);
  box-shadow: 0 20rpx 44rpx rgba(62, 62, 150, .18);
  margin-bottom: 24rpx;
}

.hero-k {
  font-size: 24rpx;
  opacity: .72;
  line-height: 1.4;
}

.hero-balance {
  margin-top: 10rpx;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
}

.hero-rate {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  opacity: .78;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #182033;
  margin-bottom: 24rpx;
}

.presets {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.preset {
  position: relative;
  min-height: 148rpx;
  padding: 28rpx 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f7f8fb;
  box-sizing: border-box;
  overflow: hidden;
}

.preset.active {
  background: #f3f1ff;
  box-shadow: inset 0 0 0 3rpx #6d5dfc;
}

.preset-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 14rpx;
  border-radius: 0 24rpx 0 16rpx;
  background: linear-gradient(135deg, #6d5dfc, #387cff);
  color: #fff;
  font-size: 18rpx;
  line-height: 1.3;
  font-weight: 600;
}

.preset-yuan {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #182033;
}

.preset.active .preset-yuan {
  color: #5b52d6;
}

.preset-points {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8b93a5;
}

.custom {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f8fb;
}

.custom.active {
  background: #f3f1ff;
  box-shadow: inset 0 0 0 3rpx #6d5dfc;
}

.custom-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.custom-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #182033;
}

.custom-tip {
  font-size: 22rpx;
  color: #8b93a5;
  line-height: 1.4;
}

.custom-field {
  margin-top: 18rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.custom-unit {
  font-size: 36rpx;
  font-weight: 800;
  color: #182033;
  line-height: 1;
}

.custom-input {
  flex: 1;
  height: 88rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #182033;
}

.summary-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef0f5;
}

.summary:last-child {
  border-bottom: 0;
}

.summary-k {
  font-size: 26rpx;
  color: #8b93a5;
  line-height: 1.4;
}

.summary-v {
  font-size: 30rpx;
  font-weight: 700;
  color: #182033;
  line-height: 1.4;
}

.summary-v.accent {
  color: #5b52d6;
}

.pay {
  margin: 8rpx 0 28rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  background: #07c160;
  box-shadow: 0 16rpx 36rpx rgba(7, 193, 96, .28);
}

.pay.disabled {
  background: #c8cdd6;
  box-shadow: none;
}

.pressed {
  opacity: .88;
}

.notes {
  padding: 0 8rpx 12rpx;
}

.note {
  position: relative;
  padding-left: 22rpx;
  margin-bottom: 12rpx;
  color: #8b93a5;
  font-size: 22rpx;
  line-height: 1.6;
}

.note::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c5c9d4;
}
