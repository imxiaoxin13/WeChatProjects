.guest-card,
.profile-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(25, 35, 70, .06);
}

.guest-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  background: linear-gradient(145deg, #6d5dfc, #387cff);
}

.guest-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  margin: 24rpx 0 10rpx;
}

.guest-sub {
  color: #8b93a5;
  font-size: 24rpx;
  line-height: 1.6;
}

.wechat-btn,
.account-btn,
.bind-btn,
.logout {
  width: 100%;
  height: 88rpx;
  padding: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.wechat-btn {
  margin-top: 36rpx;
  border-radius: 44rpx;
  color: #fff;
  background: #07c160;
}

.account-btn {
  margin-top: 18rpx;
  border-radius: 44rpx;
  background: #f4f6fa;
  color: #3d4660;
}

.pressed {
  opacity: .88;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 36rpx;
  flex-shrink: 0;
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  background: linear-gradient(145deg, #6d5dfc, #387cff);
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.display-name {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.edit {
  color: #6c61d9;
  font-size: 22rpx;
  line-height: 1;
}

.account-line {
  color: #8b93a5;
  font-size: 23rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.badges {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.badge {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eeecff;
  color: #6156db;
  font-size: 20rpx;
  line-height: 1.3;
}

.bind-btn {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: #f3f1ff;
  color: #5b52d6;
  font-size: 25rpx;
  font-weight: 600;
}

.wallet-card {
  padding: 42rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #171a35, #514cc1);
  box-shadow: 0 20rpx 50rpx rgba(52, 53, 125, .18);
  margin-bottom: 24rpx;
}

.light {
  color: rgba(255, 255, 255, .65);
}

.balance {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
  margin: 14rpx 0;
}

.frozen {
  font-size: 23rpx;
  line-height: 1.4;
  opacity: .62;
}

.menu {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #eff1f5;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.menu-tip {
  margin-top: 8rpx;
  color: #8b93a5;
  font-size: 22rpx;
  line-height: 1.4;
}

.menu-go {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(24, 32, 51, .05);
  color: #9aa3b5;
  font-size: 34rpx;
  line-height: 1;
}

.logout {
  margin: 48rpx 0 12rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #de5959;
  font-weight: 600;
}
