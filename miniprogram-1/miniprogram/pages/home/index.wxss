.hero{padding:44rpx 38rpx;border-radius:34rpx;color:#fff;background:linear-gradient(140deg,#171a35 0%,#4b45ba 64%,#6e8fff 100%);box-shadow:0 24rpx 50rpx rgba(62,62,150,.2)}.eyebrow{font-size:20rpx;letter-spacing:5rpx;opacity:.65}.hero-title{font-size:50rpx;font-weight:800;margin:18rpx 0 10rpx}.hero-sub{font-size:26rpx;opacity:.75}.balance{display:flex;justify-content:space-between;align-items:flex-end;margin-top:42rpx;padding-top:28rpx;border-top:1rpx solid rgba(255,255,255,.18)}.balance-num{font-size:54rpx;font-weight:800}.login-cta{font-size:40rpx}.balance-unit,.balance-more{font-size:24rpx;opacity:.7}.tools{display:flex;flex-direction:column;gap:18rpx}.tool{position:relative;overflow:hidden;display:flex;align-items:center;gap:22rpx;padding:28rpx 24rpx;border-radius:32rpx;background:#fff;box-shadow:0 10rpx 32rpx rgba(28,36,70,.06)}.tool-pressed{transform:scale(.985);opacity:.92}.tool-glow{position:absolute;right:-36rpx;top:-48rpx;width:180rpx;height:180rpx;border-radius:50%;pointer-events:none}.tool-image{background:linear-gradient(120deg,#f6f2ff 0%,#fff 58%);border:1rpx solid rgba(123,108,255,.12)}.tool-image .tool-glow{background:radial-gradient(circle,#c4b5fd 0%,transparent 70%)}.tool-image .tool-icon{background:linear-gradient(145deg,#7a66ff,#b388f8);box-shadow:0 14rpx 28rpx rgba(122,102,255,.32)}.tool-video{background:linear-gradient(120deg,#eef6ff 0%,#fff 58%);border:1rpx solid rgba(56,133,245,.12)}.tool-video .tool-glow{background:radial-gradient(circle,#93c5fd 0%,transparent 70%)}.tool-video .tool-icon{background:linear-gradient(145deg,#2f7ef5,#5ec3f2);box-shadow:0 14rpx 28rpx rgba(47,126,245,.28)}.tool-chat{background:linear-gradient(120deg,#e9fbf6 0%,#fff 58%);border:1rpx solid rgba(20,184,166,.14)}.tool-chat .tool-glow{background:radial-gradient(circle,#99f6e4 0%,transparent 70%)}.tool-chat .tool-icon{background:linear-gradient(145deg,#0f9f8a,#3dd6c0);box-shadow:0 14rpx 28rpx rgba(15,159,138,.28)}.tool-icon{position:relative;flex-shrink:0;width:88rpx;height:88rpx;border-radius:28rpx}.tool-copy{flex:1;min-width:0}.tool-name{font-size:32rpx;font-weight:700;color:#182033;letter-spacing:.5rpx}.tool-tip{font-size:23rpx;color:#8b93a5;margin-top:8rpx}.tool-go{flex-shrink:0;width:48rpx;height:48rpx;border-radius:50%;background:rgba(24,32,51,.05);color:#9aa3b5;font-size:34rpx;line-height:46rpx;text-align:center}.ic-frame{position:absolute;width:34rpx;height:26rpx;border:3rpx solid #fff;border-radius:7rpx}.ic-frame.back{top:24rpx;right:18rpx;opacity:.45}.ic-frame.front{left:20rpx;bottom:22rpx;overflow:hidden;background:rgba(255,255,255,.18)}.ic-sun{position:absolute;top:4rpx;right:5rpx;width:8rpx;height:8rpx;border-radius:50%;background:#fff}.ic-hill{position:absolute;left:-6rpx;bottom:-8rpx;width:28rpx;height:18rpx;border-radius:16rpx 16rpx 0 0;background:#fff;opacity:.9}.ic-play{position:absolute;top:50%;left:54%;width:0;height:0;border-top:12rpx solid transparent;border-bottom:12rpx solid transparent;border-left:20rpx solid #fff;transform:translate(-50%,-50%)}.ic-bubble{position:absolute;background:#fff;border-radius:12rpx}.ic-bubble.main{width:34rpx;height:24rpx;left:20rpx;top:24rpx;border-bottom-left-radius:4rpx}.ic-bubble.mini{width:20rpx;height:16rpx;right:18rpx;bottom:22rpx;opacity:.7;border-bottom-right-radius:4rpx}

.product-heading{display:flex;align-items:flex-end;justify-content:space-between;margin-top:14rpx}.product-title{margin-bottom:6rpx}.product-subtitle{font-size:23rpx;color:#8b93a5}.tiktok-badge{padding:11rpx 18rpx;border-radius:999rpx;background:#111827;color:#fff;font-size:20rpx;font-weight:700;letter-spacing:.5rpx;box-shadow:-5rpx 5rpx 0 #25f4ee,5rpx -5rpx 0 #fe2c55}.source-note{margin:22rpx 0 18rpx;padding:17rpx 20rpx;border-radius:18rpx;background:#edf0f6;color:#798296;font-size:20rpx}

.product-card{display:flex;align-items:flex-start;gap:20rpx;margin-bottom:18rpx;padding:26rpx 24rpx;border:1rpx solid rgba(23,29,49,.06);border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(25,35,70,.055);transition:transform .16s ease,opacity .16s ease}.product-card-pressed{transform:scale(.985);opacity:.9}.rank{display:flex;flex-shrink:0;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:18rpx;background:#eef0f5;color:#687085;font-size:24rpx;font-weight:800}.rank-1{background:linear-gradient(145deg,#f8d878,#dba73b);color:#5b3b00;box-shadow:0 8rpx 18rpx rgba(219,167,59,.24)}.rank-2{background:linear-gradient(145deg,#eef2f7,#b8c2d0);color:#4c5868}.rank-3{background:linear-gradient(145deg,#efc19f,#bd7b4f);color:#633719}.product-content{flex:1;min-width:0}.product-topline{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.product-brand{font-size:24rpx;font-weight:700;color:#5f5be8}.category-tag{flex-shrink:0;padding:6rpx 13rpx;border-radius:999rpx;background:#f3f1ff;color:#6c61d9;font-size:19rpx}.product-name{margin-top:9rpx;color:#182033;font-size:29rpx;font-weight:700;line-height:1.42}.product-metrics{display:grid;grid-template-columns:repeat(4,1fr);margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #eef0f4}.metric{min-width:0;padding:0 10rpx;border-right:1rpx solid #eef0f4;text-align:center}.metric:first-child{padding-left:0;text-align:left}.metric:last-child{padding-right:0;border-right:0;text-align:right}.metric-label{color:#9aa2b2;font-size:18rpx;white-space:nowrap}.metric-value{margin-top:7rpx;color:#3d4658;font-size:21rpx;font-weight:700;white-space:nowrap}.metric-value.gmv{color:#e34d69}.metric-value.score{color:#f19a2a}
