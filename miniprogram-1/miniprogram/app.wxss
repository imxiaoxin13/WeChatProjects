page{background:#f4f6fa;color:#182033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:28rpx 28rpx 180rpx}.card{background:#fff;border-radius:28rpx;padding:30rpx;box-shadow:0 12rpx 40rpx rgba(25,35,70,.06);margin-bottom:24rpx}.section-title{font-size:32rpx;font-weight:700;margin:12rpx 0 22rpx}.muted{color:#8b93a5;font-size:25rpx}.primary{border:0;color:#fff;background:linear-gradient(135deg,#6d5dfc,#387cff);border-radius:22rpx;font-weight:600}.ghost{border:1rpx solid #e2e6ef;background:#fff;color:#4a5368;border-radius:20rpx}.input{background:#f7f8fb;border-radius:20rpx;padding:24rpx;margin:18rpx 0}.tag{display:inline-block;padding:8rpx 15rpx;border-radius:999rpx;background:#eeecff;color:#6156db;font-size:22rpx}.row{display:flex;align-items:center;justify-content:space-between}.empty{text-align:center;color:#9aa2b2;padding:100rpx 30rpx}

