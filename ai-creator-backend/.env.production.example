APP_ENV=production
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-different-strong-password
DATABASE_URL=mysql+pymysql://ai_creator:replace-with-url-encoded-mysql-password@127.0.0.1:3306/ai_creator?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=false
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-start
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLIPCAT_API_KEY=
CLIPCAT_BASE_URL=https://clipcat.ai
HOT_PRODUCTS_TIMEZONE=Asia/Shanghai
HOT_PRODUCTS_REGION=US
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
MOCK_EXTERNAL_SERVICES=false
ALLOWED_ORIGINS=https://admin.example.com
