APP_ENV=development

# Local Docker infrastructure
MYSQL_PASSWORD=local-only-password
MYSQL_ROOT_PASSWORD=local-only-root-password
DATABASE_URL=mysql+pymysql://ai_creator:local-only-password@127.0.0.1:3306/ai_creator?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# Application security
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WeChat and AI providers. Keep mock mode enabled until new keys are configured.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLIPCAT_API_KEY=
CLIPCAT_BASE_URL=https://clipcat.ai
CLIPCAT_BIN=clipcat
HOT_PRODUCTS_TIMEZONE=Asia/Shanghai
HOT_PRODUCTS_REGION=US

# Aliyun OSS
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

MOCK_EXTERNAL_SERVICES=true
CELERY_ALWAYS_EAGER=false
