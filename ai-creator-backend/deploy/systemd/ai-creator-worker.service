[Unit]
Description=AI Creator Celery worker
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=ai-creator
Group=ai-creator
WorkingDirectory=/opt/ai-creator-backend
EnvironmentFile=/etc/ai-creator/ai-creator.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-creator-backend/.venv/bin/celery -A app.workers.celery_app:celery_app worker --loglevel=INFO --concurrency=2
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
